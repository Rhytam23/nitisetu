# Niti-Setu Environment Variables Template
# Copy this file to .env before running locally or setting up production environment variables.

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/niti-setu?retryWrites=true&w=majority

# AI Credentials (Google Gemini)
GOOGLE_API_KEY=your_gemini_api_key_here

# Frontend Production API URL (Set in frontend host like Vercel / Netlify)
VITE_API_URL=https://your-backend-domain.vercel.app

# Optional Security Admin Key for Destructive Endpoints
ADMIN_API_KEY=your_admin_secret_key_here
